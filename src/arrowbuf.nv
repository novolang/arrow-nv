// arrowbuf.nv — a buffer as a span into bytes the caller owns, and the
// bit and offset arithmetic that reads one.
//
// A buffer is two integers, a start and a length, into one body the
// caller holds: the `Bytes` that came off a socket or out of a file.
// Every accessor in this package takes that body beside the array.  So
// a read allocates nothing, a slice shares its parent's buffers, and a
// million-row batch reaches a caller as one `Bytes` and a tree of small
// structs.
//
// Every bit index is `array.offset + i`, never `i`.  A validity bitmap
// is bit-addressed from the start of the array, and an array carries an
// offset into buffers it shares with its parent, so element 0 of a
// sliced array is bit `offset` of the bitmap.  That is why
// `arrowcol.is_valid` takes the array and not the buffer.
//
// Bits are numbered least significant first within each byte (the
// columnar specification, "Validity bitmaps").  Integers and offsets
// are little-endian.
//
// Alignment and padding are the producer's concern.  The IPC
// specification requires every buffer to start on an eight-byte
// boundary and recommends sixty-four.  A reader that refused a
// misaligned buffer would refuse real files, so `check_alignment` is a
// separate call, and the accessors read unaligned.

use std.bytes
use std.float
use std.list
use arrowfault
use arrowtype

// A span into the body the caller owns.
//
// Not a `Bytes` of its own: two integers, so an array of thirty
// buffers is thirty pairs and not thirty allocations, and so a slice
// costs nothing.  Boxed rather than `@value` because
// `arrowcol.ArrowArray` is boxed and holds a list of these, and a
// `@value` struct may not be a boxed struct's field.
pub struct ArrowBuffer
    // Byte offset into the message body.
    start: Int
    // Length in bytes, as the metadata declared it.  This is the
    // declared length: it may be padded past the data, and for a
    // validity buffer it may be zero, which means "no nulls" rather
    // than "no buffer".
    len: Int

// What a buffer at a given position in an array's buffer list means.
//
// The list's positions are fixed by the type, so a role is a function
// of `(type, index)` and not something the format records.  Naming them
// is what stops a reader from passing an offsets buffer to a bitmap
// accessor: the two are both "a buffer" and reading one as the other
// produces plausible numbers.
pub enum ArrowBufferRole
    // One bit per element, LSB first within each byte, `1` meaning
    // present.  May be length zero, which means every element is
    // present.
    ArrowValidityRole
    // `length + 1` int32 entries.  Element `i` spans
    // `[offset[i], offset[i+1])`.
    ArrowOffset32Role
    // The same with int64 entries.
    ArrowOffset64Role
    // The values themselves, at the type's fixed width.
    ArrowValuesRole
    // One bit per element, for `Bool`'s values.
    ArrowBitsRole
    // One int8 per element: which child of a union holds the value.
    ArrowTypeIdRole
    // One int32 per element: where in that child the value is.  Dense
    // unions only.
    ArrowUnionOffsetRole

// The roles of an array of this type, in the order the buffers appear.
//
// The table this module is built on, and the companion to
// `arrowtype.buffer_count_of`: that one says how many, this one says
// which.  The empty list for `ArrowNull`, `[ArrowValidityRole,
// ArrowBitsRole]` for `ArrowBool`, `[ArrowTypeIdRole,
// ArrowUnionOffsetRole]` for a dense union — no validity, which is the
// entry a hand-written reader does not have.
//
// ```novo
// use arrowbuf
// use std.list
//
// fn main() [io]
//     println("${list.len(arrowbuf.layout_of(ArrowUtf8))}")
// ```
pub fn layout_of(t: ArrowType) -> [ArrowBufferRole]
    match t
        ArrowNull                    => []
        ArrowBool                    => [ArrowValidityRole, ArrowBitsRole]
        ArrowUtf8                    => [ArrowValidityRole, ArrowOffset32Role, ArrowValuesRole]
        ArrowBinary                  => [ArrowValidityRole, ArrowOffset32Role, ArrowValuesRole]
        ArrowLargeUtf8               => [ArrowValidityRole, ArrowOffset64Role, ArrowValuesRole]
        ArrowLargeBinary             => [ArrowValidityRole, ArrowOffset64Role, ArrowValuesRole]
        ArrowList                    => [ArrowValidityRole, ArrowOffset32Role]
        ArrowMap(_)                  => [ArrowValidityRole, ArrowOffset32Role]
        ArrowLargeList               => [ArrowValidityRole, ArrowOffset64Role]
        ArrowFixedSizeList(_)        => [ArrowValidityRole]
        ArrowStruct                  => [ArrowValidityRole]
        ArrowUnion(ArrowSparseUnion) => [ArrowTypeIdRole]
        ArrowUnion(ArrowDenseUnion)  => [ArrowTypeIdRole, ArrowUnionOffsetRole]
        _                            => [ArrowValidityRole, ArrowValuesRole]

// The role at a position, or a fault when the type has no buffer there.
pub fn role_at(t: ArrowType, index: Int) -> Result<ArrowBufferRole, ArrowFault>
    let roles = layout_of(t)
    if index < 0 or index >= list.len(roles)
        return Err(ArrowIndexOutOfRange(index, list.len(roles), arrowfault.nowhere()))
    Ok(roles[index])

// The role's name, for a fault report and for a dump.
pub fn role_name(r: ArrowBufferRole) -> Str
    match r
        ArrowValidityRole    => "validity"
        ArrowOffset32Role    => "offsets"
        ArrowOffset64Role    => "large offsets"
        ArrowValuesRole      => "values"
        ArrowBitsRole        => "bits"
        ArrowTypeIdRole      => "type ids"
        ArrowUnionOffsetRole => "union offsets"

// A span.
pub fn buffer(start: Int, len: Int) -> ArrowBuffer
    ArrowBuffer { start: start, len: len }

// The empty span, which is what an absent validity bitmap is.
pub fn no_buffer() -> ArrowBuffer
    ArrowBuffer { start: 0, len: 0 }

// One past the last byte of a span.
pub fn end_of(b: ArrowBuffer) -> Int
    b.start + b.len

// Whether the body is long enough to hold this span.
pub fn fits(body: Bytes, b: ArrowBuffer) -> Bool
    b.start >= 0 and b.len >= 0 and b.start + b.len <= bytes.len(body)

// The alignment the IPC specification requires of a buffer's start —
// eight bytes.
pub fn alignment() -> Int
    8

// The alignment the specification recommends — sixty-four, so a buffer
// starts on a cache line and on every vector width in use.
pub fn preferred_alignment() -> Int
    64

// `n` rounded up to the next multiple of `alignment()`.
//
// What a writer adds after every buffer, and what `arrowwrite` sizes
// with.
pub fn padded_len(n: Int) -> Int
    (n + 7) / 8 * 8

// How many bytes a validity bitmap for `n` elements needs — `n`
// bits rounded up to a byte and then to the alignment.
pub fn bitmap_bytes(n: Int) -> Int
    padded_len((n + 7) / 8)

// Whether every buffer in a list starts on the required boundary.
//
// A producer's check, not a reader's: the accessors here read unaligned
// and a reader that refused a misaligned file would refuse files that
// exist.  Run it in a writer's test suite and in a tool that audits
// somebody else's output.
pub fn check_alignment(buffers: [ArrowBuffer]) -> [ArrowFault]
    var faults: [ArrowFault] = []
    for i in 0..list.len(buffers)
        let b = buffers[i]
        if b.start % 8 != 0
            list.push(faults, ArrowMisaligned(b.start, arrowfault.at_buffer(-1, "", i, b.start)))
    faults

// ── Bitmaps ─────────────────────────────────────────────────────────

// Bit `i` of a bitmap buffer, counted from the buffer's own start.
//
// The raw accessor, and the one a caller should almost never reach for:
// an element's bit is `array.offset + i`, and `arrowcol.is_valid` is
// the call that knows that.  Published because a writer building a
// bitmap has no array yet.
pub fn bit_at(body: Bytes, b: ArrowBuffer, i: Int) -> Bool
    if i < 0 or i >= b.len * 8
        return false
    ((byte(body, b.start + i / 8) >> (i % 8)) & 1) == 1

// Bit `i` with a default for a zero-length buffer.
//
// An absent validity bitmap means "all present", and an absent `Bool`
// values buffer is a fault — so the two callers want different answers
// for the same missing buffer, and the default is an argument rather
// than a rule.
pub fn bit_at_or(body: Bytes, b: ArrowBuffer, i: Int, absent: Bool) -> Bool
    if b.len == 0
        return absent
    bit_at(body, b, i)

// How many bits are set in `[from, from + count)`.
//
// What a null count is recomputed from when a producer's declared count
// is not trusted, and what `arrowcol.slice` cannot do cheaply — which
// is why a sliced array's null count is `-1` ("unknown") rather than a
// wrong number.
pub fn count_set(body: Bytes, b: ArrowBuffer, from: Int, count: Int) -> Int
    var n = 0
    for i in from..from + count
        if bit_at(body, b, i)
            n = n + 1
    n

// The byte a run of eight bits sits in, and the bit's position in it.
//
// Published because the LSB-first order inside a byte is the detail
// that makes two implementations disagree, and a caller writing a
// bitmap by hand should use this rather than re-derive it.
pub fn bit_position(i: Int) -> (Int, Int)
    (i / 8, i % 8)

// A bitmap byte with bit `i` set, for a writer.
pub fn with_bit(byte_value: Int, i: Int, set: Bool) -> Int
    let mask = 1 << (i % 8)
    if set
        byte_value | mask
    else
        byte_value & (255 - mask)

// ── Offsets ─────────────────────────────────────────────────────────

// Entry `i` of a 32-bit offsets buffer.
pub fn offset32_at(body: Bytes, b: ArrowBuffer, i: Int) -> Result<Int, ArrowFault>
    int_at(body, b, i, 4)

// Entry `i` of a 64-bit offsets buffer.
pub fn offset64_at(body: Bytes, b: ArrowBuffer, i: Int) -> Result<Int, ArrowFault>
    int_at(body, b, i, 8)

// The span element `i` of a variable-width array covers, in the values
// buffer.
//
// `large` picks the entry width, and the two are not interchangeable:
// reading a 64-bit offsets buffer as 32-bit answers the low half of
// every entry, which for a small column is the right answer for element
// zero and wrong for every element after it.  That is the failure mode
// this argument exists to make impossible to reach by accident.
pub fn value_span(body: Bytes, offsets: ArrowBuffer, i: Int,
                  large: Bool) -> Result<ArrowBuffer, ArrowFault>
    let width = if large
        8
    else
        4
    let first = int_at(body, offsets, i, width)!
    let next = int_at(body, offsets, i + 1, width)!
    if next < first
        return Err(ArrowOffsetsNotAscending(i + 1, first, next, arrowfault.nowhere()))
    Ok(ArrowBuffer { start: first, len: next - first })

// Whether an offsets buffer ascends and ends within the values buffer.
//
// Checked on demand, not on every read: an offsets buffer is `n + 1`
// entries and validating it per element would make a random access
// linear.  A reader that does not trust its producer runs this once
// per column.
pub fn check_offsets(body: Bytes, offsets: ArrowBuffer, values_len: Int, length: Int, offset: Int,
                     large: Bool) -> [ArrowFault]
    let width = if large
        8
    else
        4
    var faults: [ArrowFault] = []
    var previous = -1
    for j in offset..offset + length + 1
        match int_at(body, offsets, j, width)
            Err(f) =>
                list.push(faults, f)
                return faults
            Ok(v)  =>
                if previous >= 0 and v < previous
                    list.push(faults, ArrowOffsetsNotAscending(j, previous, v, arrowfault.nowhere()))
                if v > values_len or v < 0
                    list.push(faults, ArrowOffsetPastEnd(j, v, values_len, arrowfault.nowhere()))
                previous = v
    faults

// ── Fixed-width values ──────────────────────────────────────────────

// The byte span of element `i` of a fixed-width values buffer.
//
// `bits` is the type's width from `arrowtype.fixed_width_bits`, and it
// is in bits rather than bytes so that `ArrowBool` has an answer here
// instead of a special case at every call site.
pub fn element_span(values: ArrowBuffer, i: Int, bits: Int) -> Result<ArrowBuffer, ArrowFault>
    let size = if bits < 8
        1
    else
        bits / 8
    let at = if bits < 8
        i * bits / 8
    else
        i * size
    if i < 0 or at + size > values.len
        let count = if bits < 8
            values.len * 8 / bits
        else
            values.len / size
        return Err(ArrowIndexOutOfRange(i, count, arrowfault.nowhere()))
    Ok(ArrowBuffer { start: values.start + at, len: size })

// A signed little-endian integer of `width` bytes at element `i`.
pub fn int_at(body: Bytes, values: ArrowBuffer, i: Int, width: Int) -> Result<Int, ArrowFault>
    let v = uint_at(body, values, i, width)!
    if width >= 8
        return Ok(v)
    let top = 1 << (8 * width - 1)
    Ok((if v >= top then v - 2 * top else v))

// An unsigned little-endian integer of `width` bytes at element `i`.
//
// Separate from `int_at` because novo-lang's `Int` is 64-bit signed and
// a `UInt64` whose top bit is set has no faithful `Int`: this answers
// the two's-complement bit pattern and `ArrowDecimalOutOfRange` is
// not raised, which is stated here so a caller reading identifiers
// knows to compare them as bit patterns.
pub fn uint_at(body: Bytes, values: ArrowBuffer, i: Int, width: Int) -> Result<Int, ArrowFault>
    let span = element_span(values, i, width * 8)!
    if span.start + width > bytes.len(body)
        return Err(ArrowShortBody(span.start + width, bytes.len(body), arrowfault.at_byte(-1, span.start)))
    var v = 0
    for k in 0..width
        v = v | (byte(body, span.start + k) << (8 * k))
    Ok(v)

// An IEEE 754 float of `width` bytes (2, 4 or 8) at element `i`,
// widened to novo-lang's `Float`.
//
// `Float16` widening is exact; `Float32` widening is exact; neither
// direction back is, and `arrowwrite` says what it rounds.
pub fn float_at(body: Bytes, values: ArrowBuffer, i: Int, width: Int) -> Result<Float, ArrowFault>
    let raw = uint_at(body, values, i, width)!
    if width == 2
        return Ok(float.from_bits(widen(raw, 5, 10)))
    if width == 4
        return Ok(float.from_bits(widen(raw, 8, 23)))
    Ok(float.from_bits(raw))

// The byte at `i`, or 0 outside the body.
fn byte(body: Bytes, i: Int) -> Int
    bytes.byte_at(body, i) ?? 0

// The bits of an IEEE 754 binary16 or binary32 value, with `e` exponent
// bits and `m` fraction bits, as the bits of the same binary64 value.
// Every such value has an exact binary64 form.
fn widen(raw: Int, e: Int, m: Int) -> Int
    let sign = (raw >> (e + m)) & 1
    let exp = (raw >> m) & ((1 << e) - 1)
    var frac = raw & ((1 << m) - 1)
    let bias = (1 << (e - 1)) - 1
    let top = sign << 63
    if exp == (1 << e) - 1
        return top | (2047 << 52) | (frac << (52 - m))
    if exp == 0
        if frac == 0
            return top
        // A subnormal: shift the fraction up until its leading one is
        // the implicit bit, counting the shifts off the exponent.
        var shift = 0
        for _ in 0..m
            if (frac & (1 << m)) == 0
                frac = frac << 1
                shift = shift + 1
        return top | ((1 - bias - shift + 1023) << 52) | ((frac & ((1 << m) - 1)) << (52 - m))
    top | ((exp - bias + 1023) << 52) | (frac << (52 - m))
