// arrowfault.nv — why a schema, a batch or a stream was refused, and
// where.
//
// A fault names three places, because an Arrow fault is seldom noticed
// where it is.  A record batch is a flat list of buffers matched to a
// tree of fields, so "buffer 11 is four bytes short" says little on its
// own, and "field `orders.items.price`, buffer 11, at body offset 4096"
// can be acted on.  `ArrowWhere` carries the message, the field path,
// the buffer index and the byte offset.
//
// Every fault is one of three kinds, and a caller reacts to each
// differently:
//
// - Incomplete: the bytes are fine so far and there are not enough of
//   them.  A reader answers this by asking for more.
// - Corrupt: the bytes contradict the format.  Neither a retry nor more
//   input helps.
// - Unsupported: the bytes are valid Arrow that this package does not
//   read, such as a run-end-encoded column.  The producer is not at
//   fault.
//
// A write that does not fit its cursor is none of the three causes and
// is classed as unsupported, so that neither `is_incomplete` nor
// `is_corrupt` is true of it.

// Where in a stream, a schema and a body a fault was found.
//
// Three coordinates rather than one, and each answers a different
// question: `message` says which message of the stream, `path` says
// which field of the schema, and `at` says which byte of the body.  A
// reader that knew only the byte offset would make its user do the
// re-association this package exists to do.
pub struct ArrowWhere
    // Which IPC message, counting from zero over the whole stream.
    // `-1` when the fault is in a value the caller built rather than in
    // something read.
    message: Int
    // The field, dotted from the schema's root — `orders.items.price`.
    // Empty for a fault that is not about a field.
    path: Str
    // The buffer's index within the message's flat buffer list, or `-1`.
    // The flat index is what the IPC metadata actually carries, so a
    // report that named only the path could not be checked against a
    // dump of the message.
    buffer: Int
    // The byte offset into the message body, or `-1`.
    at: Int

// A position with no field and no buffer — for a fault in the framing
// rather than in a column.
pub fn at_byte(message: Int, at: Int) -> ArrowWhere
    ArrowWhere { message: message, path: "", buffer: -1, at: at }

// A position inside one field's one buffer.
pub fn at_buffer(message: Int, path: Str, buffer: Int, at: Int) -> ArrowWhere
    ArrowWhere { message: message, path: path, buffer: buffer, at: at }

// A position that names only a field — for a schema fault, where there
// is no body yet.
pub fn at_field(path: Str) -> ArrowWhere
    ArrowWhere { message: -1, path: path, buffer: -1, at: -1 }

// The position for a value the caller built rather than read.
pub fn nowhere() -> ArrowWhere
    ArrowWhere { message: -1, path: "", buffer: -1, at: -1 }

// Which of the three kinds a fault is.
pub enum ArrowFaultKind
    // Valid so far, and short.  Feed more.
    ArrowIncomplete
    // The bytes contradict the format.
    ArrowCorrupt
    // Valid Arrow this package does not read.
    ArrowUnsupported

// Why a schema, an array, a message or a write was refused.
pub enum ArrowFault
    // The body ends before a buffer the metadata described.  The most
    // common fault in a truncated download, and the one a streaming
    // reader answers by asking for more bytes.
    ArrowShortBody(want: Int, have: Int, at: ArrowWhere)
    // A message's metadata claims a length the frame does not carry.
    ArrowShortMetadata(want: Int, have: Int, at: ArrowWhere)
    // The four-byte continuation marker that opens an encapsulated
    // message is not `0xFFFFFFFF`.  Arrow 0.15 introduced it and a
    // reader that skips the check silently reads a length as a header.
    ArrowBadContinuation(saw: Int, at: ArrowWhere)
    // The file format's `ARROW1` magic is missing at the head or the
    // foot.
    ArrowBadMagic(at: ArrowWhere)
    // The footer's length field points outside the file.
    ArrowFooterNotFound(at: ArrowWhere)
    // A metadata version this package does not read.  V4 and V5 are
    // read; V1 to V3 predate the encapsulated-message framing.
    ArrowVersionUnsupported(version: Int, at: ArrowWhere)
    // The schema declares an endianness that is not the reader's.
    // Arrow's buffers are raw little-endian words, so a big-endian
    // stream is not readable by byte-swapping the metadata alone.
    ArrowEndianMismatch(at: ArrowWhere)
    // A type code in the schema that is not in this package's set.
    ArrowUnknownType(code: Int, at: ArrowWhere)
    // A type that is in the spec and is not read here — the view
    // layouts, run-end encoding, and the two tensor message kinds.
    // Named separately from corruption on purpose.
    ArrowTypeUnsupported(name: Str, at: ArrowWhere)
    // A field's child count does not match what its type requires — a
    // `List` with two children, a `Struct` with none where the batch
    // says otherwise, a `Map` whose child is not a two-field struct.
    ArrowChildCountWrong(want: Int, got: Int, at: ArrowWhere)
    // The number of buffers the message carries does not match the
    // number the schema's pre-order walk requires.  The single most
    // common producer bug, because the walk order is a convention the
    // format never writes down.
    ArrowBufferCountWrong(want: Int, got: Int, at: ArrowWhere)
    // The number of field nodes does not match the walk either.
    ArrowNodeCountWrong(want: Int, got: Int, at: ArrowWhere)
    // An offsets buffer that does not ascend.  A variable-width column
    // whose offsets go backwards yields a negative length, and a reader
    // that does not check hands a caller a slice of another column.
    ArrowOffsetsNotAscending(index: Int, previous: Int, saw: Int, at: ArrowWhere)
    // An offsets buffer whose last entry is past the values buffer.
    ArrowOffsetPastEnd(index: Int, offset: Int, values_len: Int, at: ArrowWhere)
    // A length or a null count below zero.
    ArrowNegativeLength(saw: Int, at: ArrowWhere)
    // An element index outside `[0, length)` of the array as sliced.
    ArrowIndexOutOfRange(index: Int, length: Int, at: ArrowWhere)
    // A dictionary-encoded field whose dictionary has not been seen.
    // A stream may carry the batch before the dictionary only if the
    // dictionary is a delta, so this is a real fault rather than a
    // reordering to tolerate.
    ArrowDictionaryMissing(id: Int, at: ArrowWhere)
    // A dictionary whose value type is not the one the field declared.
    ArrowDictionaryTypeWrong(id: Int, at: ArrowWhere)
    // A dictionary index outside the dictionary.
    ArrowDictionaryIndexOutOfRange(index: Int, size: Int, at: ArrowWhere)
    // A union type id that the field's type-id list does not contain.
    ArrowUnionTypeIdUnknown(type_id: Int, at: ArrowWhere)
    // A decimal whose declared precision cannot hold its width, or a
    // scale outside `[0, precision]`.
    ArrowDecimalOutOfRange(precision: Int, scale: Int, at: ArrowWhere)
    // A `Utf8` value whose bytes are not UTF-8.  Checked on demand
    // rather than on read: validating every string in a batch nobody
    // reads is the cost the columnar format exists to avoid.
    ArrowNotUtf8(index: Int, at: ArrowWhere)
    // A `FixedSizeBinary` or `FixedSizeList` whose width is not
    // positive.
    ArrowBadFixedWidth(width: Int, at: ArrowWhere)
    // Two fields of one struct, or two schema-level metadata keys, with
    // the same name.  Arrow permits duplicate field names and every
    // consumer that looks a column up by name breaks on them, so the
    // check is here and `arrowtype.field_index` is the reason.
    ArrowDuplicateName(name: Str, at: ArrowWhere)
    // A message arrived where the stream's grammar does not allow it —
    // a record batch before the schema, a second schema, anything after
    // the end-of-stream marker.
    ArrowUnexpectedMessage(saw: Str, wanted: Str, at: ArrowWhere)
    // A message longer than the limit the reader was given.  The limit
    // is the caller's, because a header can claim a length no machine
    // has room for and the number must cross the interface before
    // anything is allocated.
    ArrowMessageTooLarge(want: Int, limit: Int, at: ArrowWhere)
    // The destination cursor has less room than the write needs.
    // Nothing is written when this is answered.
    ArrowWriteBufferTooSmall(want: Int, have: Int, at: ArrowWhere)
    // A caller built an array whose buffer list does not match its own
    // type's layout.  Answered by `arrowcol.validate`, never by a read.
    ArrowLayoutMismatch(want: Int, got: Int, at: ArrowWhere)
    // A type whose parameters the specification does not allow: a
    // `Time32` in microseconds, a map whose entries may be null, a
    // dictionary indexed by a string.  `what` says which rule.
    ArrowTypeInvalid(what: Str, at: ArrowWhere)
    // A buffer that does not start on the required eight-byte boundary.
    // Answered by `arrowbuf.check_alignment`, never by a read.
    ArrowMisaligned(start: Int, at: ArrowWhere)
    // A column whose length is not the batch's row count, or a struct
    // child shorter than its struct.
    ArrowLengthMismatch(want: Int, got: Int, at: ArrowWhere)
    // A read of one kind of value from a column of another: `int_at` on
    // a `Utf8` column, `child_range` on an `Int32` one.
    ArrowWrongType(want: Str, got: Str, at: ArrowWhere)

// The standard `Error` implementation, so a refused batch is reported
// by anything that reports errors.
//
// ```novo
// use arrowfault
//
// fn main() [io]
//     let f = arrowfault.short_body(512, 240, arrowfault.nowhere())
//     println(f.message())
// ```
impl Error for ArrowFault
    // The one-line report: what was wrong, and the three coordinates.
    // The field path is the half that matters — a byte offset into a
    // body nobody has a dump of is not actionable, and
    // `orders.items.price` is.
    fn message(self) -> Str
        let what = match self
            ArrowShortBody(want, have, _)                     =>
                "the body ends after ${have} byte(s) where ${want} are needed"
            ArrowShortMetadata(want, have, _)                 =>
                "the metadata ends after ${have} byte(s) where ${want} are needed"
            ArrowBadContinuation(saw, _)                      =>
                "the continuation marker is ${saw}, not 0xFFFFFFFF"
            ArrowBadMagic(_)                                  =>
                "the ARROW1 magic is missing"
            ArrowFooterNotFound(_)                            =>
                "the file footer is not where its length says"
            ArrowVersionUnsupported(version, _)               =>
                "metadata version ${version} is not read here"
            ArrowEndianMismatch(_)                            =>
                "the buffers are big-endian"
            ArrowUnknownType(code, _)                         =>
                "type code ${code} is not an Arrow type"
            ArrowTypeUnsupported(name, _)                     =>
                "the type ${name} is valid Arrow that this package does not read"
            ArrowChildCountWrong(want, got, _)                =>
                "${got} child field(s) where the type takes ${want}"
            ArrowBufferCountWrong(want, got, _)               =>
                "${got} buffer(s) where the schema's walk takes ${want}"
            ArrowNodeCountWrong(want, got, _)                 =>
                "${got} field node(s) where the schema's walk takes ${want}"
            ArrowOffsetsNotAscending(index, previous, saw, _) =>
                "offset ${index} is ${saw}, below the one before it, ${previous}"
            ArrowOffsetPastEnd(index, offset, values_len, _)  =>
                "offset ${index} is ${offset}, past the ${values_len}-byte values buffer"
            ArrowNegativeLength(saw, _)                       =>
                "a length or null count of ${saw}"
            ArrowIndexOutOfRange(index, length, _)            =>
                "index ${index} is outside an array of length ${length}"
            ArrowDictionaryMissing(id, _)                     =>
                "dictionary ${id} has not been seen"
            ArrowDictionaryTypeWrong(id, _)                   =>
                "dictionary ${id} holds values of another type than its field"
            ArrowDictionaryIndexOutOfRange(index, size, _)    =>
                "dictionary index ${index} is outside a dictionary of ${size}"
            ArrowUnionTypeIdUnknown(type_id, _)               =>
                "union type id ${type_id} is not one of the field's"
            ArrowDecimalOutOfRange(precision, scale, _)       =>
                "a decimal of precision ${precision} and scale ${scale}"
            ArrowNotUtf8(index, _)                            =>
                "value ${index} is not UTF-8"
            ArrowBadFixedWidth(width, _)                      =>
                "a fixed width of ${width}"
            ArrowDuplicateName(name, _)                       =>
                "the name `${name}` appears twice"
            ArrowUnexpectedMessage(saw, wanted, _)            =>
                "a ${saw} message where a ${wanted} message belongs"
            ArrowMessageTooLarge(want, limit, _)              =>
                "a message of ${want} byte(s) is over the limit of ${limit}"
            ArrowWriteBufferTooSmall(want, have, _)           =>
                "the write needs ${want} byte(s) and the destination has ${have}"
            ArrowLayoutMismatch(want, got, _)                 =>
                "${got} buffer(s) where the type's layout has ${want}"
            ArrowTypeInvalid(what, _)                         =>
                "${what} is not a valid Arrow type"
            ArrowMisaligned(start, _)                         =>
                "a buffer at byte ${start} is not on an eight-byte boundary"
            ArrowLengthMismatch(want, got, _)                 =>
                "an array of length ${got} where ${want} is needed"
            ArrowWrongType(want, got, _)                      =>
                "a ${got} column where ${want} is needed"
        let place = where_text(where_of(self))
        if place == ""
            return "arrow: ${what}"
        "arrow: ${what} (${place})"

// A short body, built.
pub fn short_body(want: Int, have: Int, at: ArrowWhere) -> ArrowFault
    ArrowShortBody(want, have, at)

// Which of the three kinds this fault is.
//
// The classification is fixed per variant and is not a guess: a caller
// that pumps a stream feeds more on `ArrowIncomplete`, reports the
// producer on `ArrowCorrupt`, and reports itself on
// `ArrowUnsupported`.
pub fn kind_of(f: ArrowFault) -> ArrowFaultKind
    match f
        ArrowShortBody(_, _, _)           => ArrowIncomplete
        ArrowShortMetadata(_, _, _)       => ArrowIncomplete
        ArrowVersionUnsupported(_, _)     => ArrowUnsupported
        ArrowEndianMismatch(_)            => ArrowUnsupported
        ArrowTypeUnsupported(_, _)        => ArrowUnsupported
        ArrowWriteBufferTooSmall(_, _, _) => ArrowUnsupported
        _                                 => ArrowCorrupt

// Whether more bytes could still make this succeed.
pub fn is_incomplete(f: ArrowFault) -> Bool
    kind_of(f) == ArrowIncomplete

// Whether the bytes contradict the format.
pub fn is_corrupt(f: ArrowFault) -> Bool
    kind_of(f) == ArrowCorrupt

// Where the fault was found.
pub fn where_of(f: ArrowFault) -> ArrowWhere
    match f
        ArrowShortBody(_, _, w)                 => w
        ArrowShortMetadata(_, _, w)             => w
        ArrowBadContinuation(_, w)              => w
        ArrowBadMagic(w)                        => w
        ArrowFooterNotFound(w)                  => w
        ArrowVersionUnsupported(_, w)           => w
        ArrowEndianMismatch(w)                  => w
        ArrowUnknownType(_, w)                  => w
        ArrowTypeUnsupported(_, w)              => w
        ArrowChildCountWrong(_, _, w)           => w
        ArrowBufferCountWrong(_, _, w)          => w
        ArrowNodeCountWrong(_, _, w)            => w
        ArrowOffsetsNotAscending(_, _, _, w)    => w
        ArrowOffsetPastEnd(_, _, _, w)          => w
        ArrowNegativeLength(_, w)               => w
        ArrowIndexOutOfRange(_, _, w)           => w
        ArrowDictionaryMissing(_, w)            => w
        ArrowDictionaryTypeWrong(_, w)          => w
        ArrowDictionaryIndexOutOfRange(_, _, w) => w
        ArrowUnionTypeIdUnknown(_, w)           => w
        ArrowDecimalOutOfRange(_, _, w)         => w
        ArrowNotUtf8(_, w)                      => w
        ArrowBadFixedWidth(_, w)                => w
        ArrowDuplicateName(_, w)                => w
        ArrowUnexpectedMessage(_, _, w)         => w
        ArrowMessageTooLarge(_, _, w)           => w
        ArrowWriteBufferTooSmall(_, _, w)       => w
        ArrowLayoutMismatch(_, _, w)            => w
        ArrowTypeInvalid(_, w)                  => w
        ArrowMisaligned(_, w)                   => w
        ArrowLengthMismatch(_, _, w)            => w
        ArrowWrongType(_, _, w)                 => w

// The position as one line — `message 3, orders.items.price, buffer 11,
// byte 4096` — with the absent coordinates left out rather than printed
// as `-1`.
pub fn where_text(w: ArrowWhere) -> Str
    var parts: [Str] = []
    if w.message >= 0
        list.push(parts, "message ${w.message}")
    if w.path != ""
        list.push(parts, w.path)
    if w.buffer >= 0
        list.push(parts, "buffer ${w.buffer}")
    if w.at >= 0
        list.push(parts, "byte ${w.at}")
    list.join(parts, ", ")

// The kind's name, for a log line that groups faults.
pub fn kind_name(k: ArrowFaultKind) -> Str
    match k
        ArrowIncomplete  => "incomplete"
        ArrowCorrupt     => "corrupt"
        ArrowUnsupported => "unsupported"

// A fault re-pointed at a field, for a caller that caught one from a
// child array and knows the parent's name.
//
// A child array does not know its own path — it is reached through its
// parent — so the path is assembled on the way out rather than carried
// down, which is also what keeps `ArrowArray` free of a name field it
// would have to keep in step with the schema.
pub fn under(f: ArrowFault, parent: Str) -> ArrowFault
    let w = where_of(f)
    let dotted = if w.path == ""
        parent
    else
        "${parent}.${w.path}"
    with_where(f, ArrowWhere { message: w.message, path: dotted, buffer: w.buffer, at: w.at })

// The same fault with its message index set and its byte offset counted
// from `base`.
//
// A message is read by offsets into the chunk it arrived in, so a
// reader that knows the message's index and where the chunk sits in the
// stream moves the fault's coordinates onto the stream with this.
//
// ```novo
// use arrowfault
//
// fn main() [io]
//     let f = arrowfault.short_body(512, 240, arrowfault.at_byte(-1, 16))
//     println(arrowfault.where_text(arrowfault.where_of(arrowfault.in_message(f, 3, 1000))))
// ```
pub fn in_message(f: ArrowFault, message: Int, base: Int) -> ArrowFault
    let w = where_of(f)
    let at = if w.at >= 0
        w.at + base
    else
        w.at
    with_where(f, ArrowWhere { message: message, path: w.path, buffer: w.buffer, at: at })

// The same fault at another position.
fn with_where(f: ArrowFault, w: ArrowWhere) -> ArrowFault
    match f
        ArrowShortBody(a, b, _)                 => ArrowShortBody(a, b, w)
        ArrowShortMetadata(a, b, _)             => ArrowShortMetadata(a, b, w)
        ArrowBadContinuation(a, _)              => ArrowBadContinuation(a, w)
        ArrowBadMagic(_)                        => ArrowBadMagic(w)
        ArrowFooterNotFound(_)                  => ArrowFooterNotFound(w)
        ArrowVersionUnsupported(a, _)           => ArrowVersionUnsupported(a, w)
        ArrowEndianMismatch(_)                  => ArrowEndianMismatch(w)
        ArrowUnknownType(a, _)                  => ArrowUnknownType(a, w)
        ArrowTypeUnsupported(a, _)              => ArrowTypeUnsupported(a, w)
        ArrowChildCountWrong(a, b, _)           => ArrowChildCountWrong(a, b, w)
        ArrowBufferCountWrong(a, b, _)          => ArrowBufferCountWrong(a, b, w)
        ArrowNodeCountWrong(a, b, _)            => ArrowNodeCountWrong(a, b, w)
        ArrowOffsetsNotAscending(a, b, c, _)    => ArrowOffsetsNotAscending(a, b, c, w)
        ArrowOffsetPastEnd(a, b, c, _)          => ArrowOffsetPastEnd(a, b, c, w)
        ArrowNegativeLength(a, _)               => ArrowNegativeLength(a, w)
        ArrowIndexOutOfRange(a, b, _)           => ArrowIndexOutOfRange(a, b, w)
        ArrowDictionaryMissing(a, _)            => ArrowDictionaryMissing(a, w)
        ArrowDictionaryTypeWrong(a, _)          => ArrowDictionaryTypeWrong(a, w)
        ArrowDictionaryIndexOutOfRange(a, b, _) => ArrowDictionaryIndexOutOfRange(a, b, w)
        ArrowUnionTypeIdUnknown(a, _)           => ArrowUnionTypeIdUnknown(a, w)
        ArrowDecimalOutOfRange(a, b, _)         => ArrowDecimalOutOfRange(a, b, w)
        ArrowNotUtf8(a, _)                      => ArrowNotUtf8(a, w)
        ArrowBadFixedWidth(a, _)                => ArrowBadFixedWidth(a, w)
        ArrowDuplicateName(a, _)                => ArrowDuplicateName(a, w)
        ArrowUnexpectedMessage(a, b, _)         => ArrowUnexpectedMessage(a, b, w)
        ArrowMessageTooLarge(a, b, _)           => ArrowMessageTooLarge(a, b, w)
        ArrowWriteBufferTooSmall(a, b, _)       => ArrowWriteBufferTooSmall(a, b, w)
        ArrowLayoutMismatch(a, b, _)            => ArrowLayoutMismatch(a, b, w)
        ArrowTypeInvalid(a, _)                  => ArrowTypeInvalid(a, w)
        ArrowMisaligned(a, _)                   => ArrowMisaligned(a, w)
        ArrowLengthMismatch(a, b, _)            => ArrowLengthMismatch(a, b, w)
        ArrowWrongType(a, b, _)                 => ArrowWrongType(a, b, w)
