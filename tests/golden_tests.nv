fn check_primitive(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["bool_nullable",
        "bool_nonnullable",
        "int8_nullable",
        "int8_nonnullable",
        "int16_nullable",
        "int16_nonnullable",
        "int32_nullable",
