fn test_primitive_large_offsets_stream_reads_as_its_json_says()
    check_primitive_large_offsets(primitive_large_offsets_stream(),
        events_of(primitive_large_offsets_stream(), ArrowStreamFormat))

@test
fn test_primitive_large_offsets_stream_written_back_reads_the_same()
    let again = rewrite(primitive_large_offsets_stream(), ArrowStreamFormat)
    check_primitive_large_offsets(again, events_of(again, ArrowStreamFormat))

