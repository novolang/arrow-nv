@test
fn test_primitive_zerolength_stream_reads_as_its_json_says()
    check_primitive_zerolength(primitive_zerolength_stream(), events_of(primitive_zerolength_stream(), ArrowStreamFormat))

@test
fn test_primitive_zerolength_stream_written_back_reads_the_same()
    let again = rewrite(primitive_zerolength_stream(), ArrowStreamFormat)
    check_primitive_zerolength(again, events_of(again, ArrowStreamFormat))

fn primitive_large_offsets_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_primitive_large_offsets(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["largebinary_nullable",
        "largebinary_nonnullable",
        "largeutf8_nullable",
        "largeutf8_nonnullable"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 2)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 17)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 17)
