fn recursive_nested_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_recursive_nested(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["lists_list",
        "lists_list.inner_list",
        "lists_list.inner_list.item",
        "structs_list",
        "structs_list.inner_struct",
        "structs_list.inner_struct.f1",
        "structs_list.inner_struct.f2"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 2)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 7)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 7)
    check_valid(body, c1, [true, true, true, false, false, false, true])
    check_offsets(body, c1, [0, 1, 5, 8, 8, 8, 8, 8], false)
    check_ranges(body, c1, [0, 1, 5, 8, 8, 8, 8, 8], false)
    let c2 = c1.children[0]
    test.assert_eq(c2.length, 8)
    check_valid(body, c2, [false, true, true, true, true, true, true, true])
    check_offsets(body, c2, [0, 0, 1, 3, 3, 6, 6, 8, 11], false)
    check_ranges(body, c2, [0, 0, 1, 3, 3, 6, 6, 8, 11], false)
    let c3 = c2.children[0]
    test.assert_eq(c3.length, 11)
    check_valid(body, c3, [true, true, true, true, true, false, false, true, true, false, false])
    check_ints(body,
        c3,
        [-32768, 32767, -3968, -16914, 27700, -5568, 7368, 27536, -29362, -16464, 17126],
        [true, true, true, true, true, false, false, true, true, false, false])
    let c4 = b0.columns[1]
    test.assert_eq(c4.length, 7)
    check_valid(body, c4, [true, false, true, false, true, false, true])
    check_offsets(body, c4, [0, 4, 4, 6, 6, 7, 7, 11], false)
    check_ranges(body, c4, [0, 4, 4, 6, 6, 7, 7, 11], false)
    let c5 = c4.children[0]
    test.assert_eq(c5.length, 11)
    check_valid(body, c5, [true, true, false, false, true, true, true, true, false, false, false])
    check_struct(c5, 2)
    let c6 = c5.children[0]
    test.assert_eq(c6.length, 11)
    check_valid(body, c6, [true, false, true, false, true, false, true, false, false, true, true])
    check_ints(body, c6, [-2147483648,
        2147483647,
        391790101,
