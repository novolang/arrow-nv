@test
fn test_primitive_stream_reads_as_its_json_says()
    check_primitive(primitive_stream(), events_of(primitive_stream(), ArrowStreamFormat))

@test
fn test_primitive_stream_written_back_reads_the_same()
    let again = rewrite(primitive_stream(), ArrowStreamFormat)
    check_primitive(again, events_of(again, ArrowStreamFormat))

fn primitive_zerolength_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_primitive_zerolength(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["bool_nullable",
        "bool_nonnullable",
        "int8_nullable",
        "int8_nonnullable",
        "int16_nullable",
        "int16_nonnullable",
        "int32_nullable",
        "int32_nonnullable",
        "int64_nullable",
        "int64_nonnullable",
        "uint8_nullable",
        "uint8_nonnullable",
        "uint16_nullable",
        "uint16_nonnullable",
        "uint32_nullable",
        "uint32_nonnullable",
        "uint64_nullable",
        "uint64_nonnullable",
        "float32_nullable",
        "float32_nonnullable",
        "float64_nullable",
        "float64_nonnullable",
        "binary_nullable",
        "binary_nonnullable",
        "utf8_nullable",
        "utf8_nonnullable",
        "fixedsizebinary_19_nullable",
        "fixedsizebinary_19_nonnullable",
        "fixedsizebinary_120_nullable",
        "fixedsizebinary_120_nonnullable"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 3)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 0)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 0)
    check_valid(body, c1, [])
    check_bools(body, c1, [], [])
    let c2 = b0.columns[1]
    test.assert_eq(c2.length, 0)
    check_valid(body, c2, [])
    check_bools(body, c2, [], [])
    let c3 = b0.columns[2]
    test.assert_eq(c3.length, 0)
    check_valid(body, c3, [])
    check_ints(body, c3, [], [])
    let c4 = b0.columns[3]
    test.assert_eq(c4.length, 0)
    check_valid(body, c4, [])
    check_ints(body, c4, [], [])
    let c5 = b0.columns[4]
    test.assert_eq(c5.length, 0)
    check_valid(body, c5, [])
    check_ints(body, c5, [], [])
    let c6 = b0.columns[5]
    test.assert_eq(c6.length, 0)
    check_valid(body, c6, [])
    check_ints(body, c6, [], [])
    let c7 = b0.columns[6]
    test.assert_eq(c7.length, 0)
    check_valid(body, c7, [])
    check_ints(body, c7, [], [])
    let c8 = b0.columns[7]
    test.assert_eq(c8.length, 0)
    check_valid(body, c8, [])
    check_ints(body, c8, [], [])
    let c9 = b0.columns[8]
    test.assert_eq(c9.length, 0)
    check_valid(body, c9, [])
    check_ints(body, c9, [], [])
    let c10 = b0.columns[9]
    test.assert_eq(c10.length, 0)
    check_valid(body, c10, [])
    check_ints(body, c10, [], [])
    let c11 = b0.columns[10]
    test.assert_eq(c11.length, 0)
    check_valid(body, c11, [])
    check_ints(body, c11, [], [])
    let c12 = b0.columns[11]
    test.assert_eq(c12.length, 0)
    check_valid(body, c12, [])
    check_ints(body, c12, [], [])
    let c13 = b0.columns[12]
    test.assert_eq(c13.length, 0)
    check_valid(body, c13, [])
    check_ints(body, c13, [], [])
    let c14 = b0.columns[13]
    test.assert_eq(c14.length, 0)
    check_valid(body, c14, [])
    check_ints(body, c14, [], [])
    let c15 = b0.columns[14]
    test.assert_eq(c15.length, 0)
    check_valid(body, c15, [])
    check_ints(body, c15, [], [])
    let c16 = b0.columns[15]
    test.assert_eq(c16.length, 0)
    check_valid(body, c16, [])
    check_ints(body, c16, [], [])
    let c17 = b0.columns[16]
