@test
fn test_nested_stream_reads_as_its_json_says()
    check_nested(nested_stream(), events_of(nested_stream(), ArrowStreamFormat))

@test
fn test_nested_stream_written_back_reads_the_same()
    let again = rewrite(nested_stream(), ArrowStreamFormat)
    check_nested(again, events_of(again, ArrowStreamFormat))

@test
fn test_nested_file_reads_by_feeding_and_through_its_footer()
    let src = nested_file()
    check_nested(src, events_of(src, ArrowFileFormat))
    let tail = bytes.slice(src, bytes.len(src) - 10, bytes.len(src))
    match arrowipc.footer_position(tail, bytes.len(src))
        Err(e) => test.fail(e.message())
        Ok(at) =>
            match arrowipc.read_footer(src, at, bytes.len(src) - 10 - at)
                Err(e) => test.fail(e.message())
                Ok(f)  =>
                    test.assert_eq(list.len(f.batches), 2)
                    test.assert_eq(arrowtype.field_paths(f.schema), ["list_nullable",
                        "list_nullable.item",
                        "fixedsizelist_nullable",
                        "fixedsizelist_nullable.item",
                        "struct_nullable",
                        "struct_nullable.f1",
                        "struct_nullable.f2"])
    let again = rewrite(nested_stream(), ArrowFileFormat)
    check_nested(again, events_of(again, ArrowFileFormat))

fn nested_large_offsets_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_nested_large_offsets(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["large_list_nullable",
        "large_list_nullable.item",
        "large_list_nonnullable",
