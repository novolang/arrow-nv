        1732941905,
        -312764233,
        117351222,
        1585143085,
        1422756883,
        -2084938953,
        -58586548],
    [true, false, true, false, true, false, true, false, false, true, true])
    let c7 = c5.children[1]
    test.assert_eq(c7.length, 11)
    check_valid(body, c7, [true, true, true, false, true, false, true, false, false, true, true])
    check_strs(body, c7, ["3b€fpi4",
        "iaakg5p",
        "nôp°o矢p",
        "",
        "3jra矢nô",
        "",
        "icik矢6µ",
        "",
        "",
        "fei矢are",
        "i2kjôgh"],
    [true, true, true, false, true, false, true, false, false, true, true])
    let b1 = batches[1]
    test.assert_eq(b1.rows, 10)
    test.assert(arrowcol.batch_ok(body, b1))
    let c8 = b1.columns[0]
    test.assert_eq(c8.length, 10)
    check_valid(body, c8, [false, true, false, true, false, false, false, false, true, true])
    check_offsets(body, c8, [0, 0, 0, 0, 2, 2, 2, 2, 2, 3, 6], false)
    check_ranges(body, c8, [0, 0, 0, 0, 2, 2, 2, 2, 2, 3, 6], false)
