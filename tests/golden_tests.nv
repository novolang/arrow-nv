    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 0)
    check_valid(body, c1, [])
    check_offsets(body, c1, [0], true)
    check_ranges(body, c1, [0], false)
    let c2 = c1.children[0]
    test.assert_eq(c2.length, 0)
    check_valid(body, c2, [])
    check_ints(body, c2, [], [])
    let c3 = b0.columns[1]
    test.assert_eq(c3.length, 0)
