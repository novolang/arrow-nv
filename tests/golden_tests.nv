@test
fn test_dictionary_stream_reads_as_its_json_says()
    check_dictionary(dictionary_stream(), events_of(dictionary_stream(), ArrowStreamFormat))

@test
fn test_dictionary_stream_written_back_reads_the_same()
    let again = rewrite(dictionary_stream(), ArrowStreamFormat)
    check_dictionary(again, events_of(again, ArrowStreamFormat))

@test
fn test_dictionary_file_reads_by_feeding_and_through_its_footer()
    let src = dictionary_file()
    check_dictionary(src, events_of(src, ArrowFileFormat))
    let tail = bytes.slice(src, bytes.len(src) - 10, bytes.len(src))
    match arrowipc.footer_position(tail, bytes.len(src))
        Err(e) => test.fail(e.message())
        Ok(at) =>
            match arrowipc.read_footer(src, at, bytes.len(src) - 10 - at)
                Err(e) => test.fail(e.message())
                Ok(f)  =>
                    test.assert_eq(list.len(f.batches), 2)
                    test.assert_eq(arrowtype.field_paths(f.schema), ["dict0", "dict1", "dict2"])
    let again = rewrite(dictionary_stream(), ArrowFileFormat)
    check_dictionary(again, events_of(again, ArrowFileFormat))

fn dictionary_unsigned_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_dictionary_unsigned(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["f0", "f1", "f2"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 2)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 7)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 7)
    check_valid(body, c1, [false, false, true, true, true, false, true])
    check_ints(body, c1, [1, 3, 4, 1, 0, 1, 1], [false, false, true, true, true, false, true])
    check_dict_strs(body,
        b0,
        c1,
        ["", "", "deppmfc", "ad4i6Âe", "", "", "ad4i6Âe"],
        [false, false, true, true, true, false, true])
    let c2 = b0.columns[1]
    test.assert_eq(c2.length, 7)
    check_valid(body, c2, [true, true, false, false, true, false, true])
    check_ints(body, c2, [4, 4, 4, 2, 2, 1, 1], [true, true, false, false, true, false, true])
    check_dict_strs(body, b0, c2, ["", "", "", "", "", "", ""], [true, true, false, false, true, false, true])
    let c3 = b0.columns[2]
    test.assert_eq(c3.length, 7)
    check_valid(body, c3, [false, true, true, false, true, true, true])
    check_ints(body, c3, [3, 3, 2, 1, 2, 3, 0], [false, true, true, false, true, true, true])
    check_dict_strs(body,
        b0,
        c3,
        ["", "", "ircepe5", "", "ircepe5", "", "waj£eµi"],
        [false, true, true, false, true, true, true])
    let b1 = batches[1]
    test.assert_eq(b1.rows, 10)
    test.assert(arrowcol.batch_ok(body, b1))
    let c4 = b1.columns[0]
    test.assert_eq(c4.length, 10)
    check_valid(body, c4, [false, false, true, false, true, true, false, true, false, false])
    check_ints(body,
        c4,
        [2, 1, 2, 0, 2, 3, 0, 2, 0, 3],
        [false, false, true, false, true, true, false, true, false, false])
    check_dict_strs(body,
        b1,
        c4,
        ["", "", "", "", "", "", "", "", "", ""],
        [false, false, true, false, true, true, false, true, false, false])
    let c5 = b1.columns[1]
    test.assert_eq(c5.length, 10)
    check_valid(body, c5, [false, false, true, false, true, true, true, false, false, false])
    check_ints(body,
        c5,
        [2, 4, 2, 4, 4, 3, 3, 3, 0, 4],
        [false, false, true, false, true, true, true, false, false, false])
    check_dict_strs(body,
        b1,
        c5,
        ["", "", "", "", "", "°c24矢l2", "°c24矢l2", "", "", ""],
        [false, false, true, false, true, true, true, false, false, false])
    let c6 = b1.columns[2]
    test.assert_eq(c6.length, 10)
    check_valid(body, c6, [true, false, false, true, false, true, true, true, true, true])
    check_ints(body,
        c6,
        [2, 1, 2, 1, 1, 3, 3, 1, 0, 1],
        [true, false, false, true, false, true, true, true, true, true])
    check_dict_strs(body,
        b1,
        c6,
        ["ircepe5", "", "", "", "", "", "", "", "waj£eµi", ""],
        [true, false, false, true, false, true, true, true, true, true])
    let dicts = dictionaries_in(events)
    test.assert_eq(list.len(dicts), 3)
    let c7 = dicts[0]
    test.assert_eq(c7.length, 5)
    check_valid(body, c7, [false, true, false, false, true])
    check_strs(body, c7, ["", "ad4i6Âe", "", "", "deppmfc"], [false, true, false, false, true])
    let c8 = dicts[1]
    test.assert_eq(c8.length, 5)
    check_valid(body, c8, [true, false, false, true, false])
    check_strs(body, c8, ["°mfawr3", "", "", "°c24矢l2", ""], [true, false, false, true, false])
    let c9 = dicts[2]
    test.assert_eq(c9.length, 5)
    check_valid(body, c9, [true, false, true, false, true])
    check_strs(body, c9, ["waj£eµi", "", "ircepe5", "", "ô3lb5b4"], [true, false, true, false, true])

@test
fn test_dictionary_unsigned_stream_reads_as_its_json_says()
    check_dictionary_unsigned(dictionary_unsigned_stream(), events_of(dictionary_unsigned_stream(), ArrowStreamFormat))

@test
fn test_dictionary_unsigned_stream_written_back_reads_the_same()
    let again = rewrite(dictionary_unsigned_stream(), ArrowStreamFormat)
    check_dictionary_unsigned(again, events_of(again, ArrowStreamFormat))

fn nested_dictionary_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_nested_dictionary(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["list_dict", "struct_dict"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 2)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 10)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 10)
    check_valid(body, c1, [true, false, false, true, false, false, true, true, false, true])
    check_ints(body,
        c1,
        [27, 23, 8, 1, 25, 17, 22, 22, 3, 13],
        [true, false, false, true, false, false, true, true, false, true])
    let c2 = b0.columns[1]
    test.assert_eq(c2.length, 10)
    check_valid(body, c2, [false, true, false, true, false, true, false, true, true, true])
    check_ints(body,
        c2,
        [28, 27, 11, 25, 19, 20, 15, 14, 20, 16],
        [false, true, false, true, false, true, false, true, true, true])
    let b1 = batches[1]
    test.assert_eq(b1.rows, 13)
    test.assert(arrowcol.batch_ok(body, b1))
    let c3 = b1.columns[0]
    test.assert_eq(c3.length, 13)
    check_valid(body, c3, [true, true, false, true, true, true, false, true, false, false, true, false, true])
    check_ints(body,
        c3,
        [23, 2, 14, 1, 13, 27, 0, 19, 19, 24, 12, 6, 4],
        [true, true, false, true, true, true, false, true, false, false, true, false, true])
    let c4 = b1.columns[1]
    test.assert_eq(c4.length, 13)
    check_valid(body,
        c4,
        [false, false, false, false, false, true, false, true, true, false, true, true, true])
    check_ints(body,
        c4,
        [18, 24, 4, 15, 11, 23, 19, 27, 4, 11, 23, 21, 14],
        [false, false, false, false, false, true, false, true, true, false, true, true, true])

@test
fn test_nested_dictionary_stream_reads_as_its_json_says()
    check_nested_dictionary(nested_dictionary_stream(), events_of(nested_dictionary_stream(), ArrowStreamFormat))

@test
fn test_nested_dictionary_stream_written_back_reads_the_same()
    let again = rewrite(nested_dictionary_stream(), ArrowStreamFormat)
    check_nested_dictionary(again, events_of(again, ArrowStreamFormat))

fn custom_metadata_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_custom_metadata(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["sort_of_pandas",
        "lots_of_meta",
        "unregistered_extension",
        "list_with_odd_values",
        "list_with_odd_values.item"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 1)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 1)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 1)
    check_valid(body, c1, [false])
    check_ints(body, c1, [36], [false])
    let c2 = b0.columns[1]
    test.assert_eq(c2.length, 1)
    check_valid(body, c2, [false])
    check_ints(body, c2, [109], [false])
    let c3 = b0.columns[2]
    test.assert_eq(c3.length, 1)
    check_valid(body, c3, [false])
    check_ints(body, c3, [50], [false])
    let c4 = b0.columns[3]
    test.assert_eq(c4.length, 1)
    check_valid(body, c4, [false])
    check_offsets(body, c4, [0, 0], false)
    check_ranges(body, c4, [0, 0], false)
    let c5 = c4.children[0]
    test.assert_eq(c5.length, 0)
    check_valid(body, c5, [])
    check_ints(body, c5, [], [])

@test
fn test_custom_metadata_stream_reads_as_its_json_says()
    check_custom_metadata(custom_metadata_stream(), events_of(custom_metadata_stream(), ArrowStreamFormat))

@test
fn test_custom_metadata_stream_written_back_reads_the_same()
    let again = rewrite(custom_metadata_stream(), ArrowStreamFormat)
    check_custom_metadata(again, events_of(again, ArrowStreamFormat))

fn duplicate_fieldnames_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn check_duplicate_fieldnames(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["ints", "ints", "struct", "struct.", "struct."])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 1)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 1)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 1)
    check_valid(body, c1, [false])
    check_ints(body, c1, [-77], [false])
    let c2 = b0.columns[1]
    test.assert_eq(c2.length, 1)
    check_valid(body, c2, [false])
    check_ints(body, c2, [-1117583456], [false])
    let c3 = b0.columns[2]
    test.assert_eq(c3.length, 1)
    check_valid(body, c3, [true])
    check_struct(c3, 2)
    let c4 = c3.children[0]
    test.assert_eq(c4.length, 1)
    check_valid(body, c4, [true])
    check_ints(body, c4, [1296194679], [true])
    let c5 = c3.children[1]
    test.assert_eq(c5.length, 1)
    check_valid(body, c5, [true])
    check_strs(body, c5, ["ôjllc4i"], [true])

@test
fn test_duplicate_fieldnames_stream_reads_as_its_json_says()
    check_duplicate_fieldnames(duplicate_fieldnames_stream(), events_of(duplicate_fieldnames_stream(), ArrowStreamFormat))

@test
fn test_duplicate_fieldnames_stream_written_back_reads_the_same()
    let again = rewrite(duplicate_fieldnames_stream(), ArrowStreamFormat)
    check_duplicate_fieldnames(again, events_of(again, ArrowStreamFormat))
