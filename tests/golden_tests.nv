fn check_dictionary(body: Bytes, events: [ArrowIpcEvent])
    let s = schema_in(events)
    test.assert_eq(arrowtype.field_paths(s), ["dict0", "dict1", "dict2"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 2)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 7)
    test.assert(arrowcol.batch_ok(body, b0))
    let c1 = b0.columns[0]
    test.assert_eq(c1.length, 7)
    check_valid(body, c1, [true, false, true, false, false, false, false])
    check_ints(body, c1, [2, 7, 3, 7, 0, 4, 8], [true, false, true, false, false, false, false])
    check_dict_strs(body,
        b0,
        c1,
        ["nwg€6d€", "", "", "", "", "", ""],
        [true, false, true, false, false, false, false])
    let c2 = b0.columns[1]
    test.assert_eq(c2.length, 7)
    check_valid(body, c2, [false, false, true, true, true, false, true])
    check_ints(body, c2, [4, 1, 0, 0, 1, 4, 4], [false, false, true, true, true, false, true])
    check_dict_strs(body,
        b0,
        c2,
        ["", "", "be£jdbi", "be£jdbi", "", "", "f6µfmµi"],
        [false, false, true, true, true, false, true])
    let c3 = b0.columns[2]
    test.assert_eq(c3.length, 7)
    check_valid(body, c3, [true, false, true, true, true, true, true])
    check_ints(body, c3, [47, 32, 6, 49, 20, 13, 41], [true, false, true, true, true, true, true])
    let b1 = batches[1]
    test.assert_eq(b1.rows, 10)
    test.assert(arrowcol.batch_ok(body, b1))
    let c4 = b1.columns[0]
    test.assert_eq(c4.length, 10)
    check_valid(body, c4, [false, true, true, true, false, true, false, false, false, true])
    check_ints(body,
        c4,
        [3, 9, 8, 5, 0, 4, 8, 2, 4, 9],
        [false, true, true, true, false, true, false, false, false, true])
    check_dict_strs(body,
        b1,
        c4,
        ["", "", "e£a5µ矢a", "", "", "rpc£µ£3", "", "", "", ""],
        [false, true, true, true, false, true, false, false, false, true])
    let c5 = b1.columns[1]
    test.assert_eq(c5.length, 10)
    check_valid(body, c5, [false, true, false, false, true, true, true, true, true, false])
    check_ints(body,
        c5,
        [4, 0, 4, 1, 2, 4, 2, 3, 3, 0],
        [false, true, false, false, true, true, true, true, true, false])
    check_dict_strs(body,
        b1,
        c5,
        ["", "be£jdbi", "", "", "iµfcfoe", "f6µfmµi", "iµfcfoe", "", "", ""],
        [false, true, false, false, true, true, true, true, true, false])
    let c6 = b1.columns[2]
    test.assert_eq(c6.length, 10)
    check_valid(body, c6, [false, true, true, true, false, true, true, false, true, true])
    check_ints(body,
        c6,
        [23, 49, 40, 30, 22, 33, 42, 28, 36, 14],
        [false, true, true, true, false, true, true, false, true, true])
    let dicts = dictionaries_in(events)
    test.assert_eq(list.len(dicts), 3)
    let c7 = dicts[0]
    test.assert_eq(c7.length, 10)
    check_valid(body, c7, [true, false, true, false, true, false, false, false, true, false])
    check_strs(body,
        c7,
        ["2lf4µµr", "", "nwg€6d€", "", "rpc£µ£3", "", "", "", "e£a5µ矢a", ""],
        [true, false, true, false, true, false, false, false, true, false])
    let c8 = dicts[1]
    test.assert_eq(c8.length, 5)
    check_valid(body, c8, [true, false, true, false, true])
    check_strs(body, c8, ["be£jdbi", "", "iµfcfoe", "", "f6µfmµi"], [true, false, true, false, true])
    let c9 = dicts[2]
    test.assert_eq(c9.length, 50)
