        "large_list_nested",
        "large_list_nested.inner_list",
        "large_list_nested.inner_list.item"])
    let batches = batches_in(events)
    test.assert_eq(list.len(batches), 2)
    let b0 = batches[0]
    test.assert_eq(b0.rows, 0)
