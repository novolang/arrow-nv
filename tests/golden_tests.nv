    check_interval(interval_stream(), events_of(interval_stream(), ArrowStreamFormat))

@test
fn test_interval_stream_written_back_reads_the_same()
    let again = rewrite(interval_stream(), ArrowStreamFormat)
    check_interval(again, events_of(again, ArrowStreamFormat))

fn nested_stream() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

